{
  "name": "entra-oauth-playground",
  "version": "0.0.2",
  "private": true,
  "scripts": {
    "dev": "SASS_SILENCE_DEPRECATIONS=import,legacy-js-api next dev --experimental-https",
    "build": "SASS_SILENCE_DEPRECATIONS=import,legacy-js-api next build",
    "start": "next start",
    "format": "prettier --write \"{app,demo,layout,types,src,tests,e2e}/**/*.{js,ts,tsx,d.ts}\" playwright.config.ts vitest.config.mts",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "e2e:offline": "playwright test --project=offline",
    "e2e:live": "playwright test --project=live",
    "e2e:ui": "playwright test --ui",
    "screenshots": "E2E_CAPTURE=1 playwright test --project=screenshots",
    "provision:auth0": "node scripts/provision-auth0.mts"
  },
  "dependencies": {
    "flag-icons": "7.5.0",
    "jose": "6.1.3",
    "next": "16.1.6",
    "next-intl": "4.8.3",
    "primeflex": "4.0.0",
    "primeicons": "7.0.0",
    "primereact": "10.9.7",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/node": "25.3.0",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "eslint": "9.39.3",
    "eslint-config-next": "16.1.6",
    "prettier": "3.8.1",
    "sass": "1.97.3",
    "typescript": "5.9.3",
    "vitest": "^4.1.10"
  }
}
