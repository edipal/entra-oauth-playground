# Copy to .env.e2e.local (gitignored) and fill in. Never commit the filled file.
# Used only by the Playwright "live" project: pnpm e2e:live
#
# Use a throwaway test tenant and test app registrations with least privilege.
# The test user must have MFA and Conditional Access disabled, or the interactive
# authorization-code specs cannot complete.

# ---------------------------------------------------------------- Microsoft Entra
E2E_ENTRA_TENANT_ID=
# App registration with redirect URI https://localhost:3000/callback/auth-code
# registered under the "Single-page application" platform
E2E_ENTRA_PUBLIC_CLIENT_ID=
# App registration with the same redirect URI under the "Web" platform
E2E_ENTRA_CONFIDENTIAL_CLIENT_ID=
E2E_ENTRA_CLIENT_SECRET=
# PEM private key whose certificate is uploaded to the confidential app.
# Escape newlines as \n, or wrap the whole value in double quotes.
E2E_ENTRA_PRIVATE_KEY_PEM=
# The matching certificate, uploaded to the app registration
E2E_ENTRA_CERTIFICATE_PEM=
# base64url SHA-1 thumbprint of that certificate (the x5t JWT header value)
E2E_ENTRA_CLIENT_ASSERTION_X5T=
E2E_ENTRA_USER_SCOPES=openid profile offline_access User.Read
E2E_ENTRA_APP_SCOPE=https://graph.microsoft.com/.default
E2E_ENTRA_API_ENDPOINT=https://graph.microsoft.com/v1.0/me
E2E_ENTRA_USERNAME=
E2E_ENTRA_PASSWORD=

# ------------------------------------------------------------------------- Auth0
# Tenant issuer, for example https://your-tenant.eu.auth0.com
E2E_AUTH0_ISSUER_URL=
# Optional, and read only by pnpm provision:auth0 — never by the specs. A
# Management API token, so that provisioning a tenant again needs no arguments.
# AUTH0_MGMT_TOKEN_FILE=/path/to/token works the same way and keeps it out of here.
AUTH0_MGMT_TOKEN=
# Single Page Application, callback URL https://localhost:3000/callback/auth-code
E2E_AUTH0_PUBLIC_CLIENT_ID=
# Regular Web Application with the same callback URL
E2E_AUTH0_CONFIDENTIAL_CLIENT_ID=
E2E_AUTH0_CLIENT_SECRET=
# Machine to Machine application authorized for the API below
E2E_AUTH0_M2M_CLIENT_ID=
E2E_AUTH0_M2M_CLIENT_SECRET=
# private_key_jwt needs its own applications: Auth0 makes the authentication
# method exclusive, so turning it on hides the client secret and would break the
# client-secret specs above. Create a Machine to Machine application and a Regular
# Web Application, and on each set Credentials -> Authentication Methods to
# Private Key JWT (adding a credential alone does NOT switch the method).
E2E_AUTH0_PKJWT_M2M_CLIENT_ID=
E2E_AUTH0_PKJWT_CLIENT_ID=
# Both applications normally live on the same tenant as everything above, and both
# private_key_jwt specs pass in one run. Everything below is an escape hatch for a
# tenant that cannot host them, and falls back to the values above when empty — so
# set only what actually differs. A separate tenant needs its own API and test
# user: the round trip cannot straddle two tenants.
E2E_AUTH0_PKJWT_ISSUER_URL=
E2E_AUTH0_PKJWT_AUDIENCE=
E2E_AUTH0_PKJWT_API_ENDPOINT=
E2E_AUTH0_PKJWT_USERNAME=
E2E_AUTH0_PKJWT_PASSWORD=
# Private key for private_key_jwt and for signing JAR request objects. Register
# the matching public key on both applications above.
E2E_AUTH0_PRIVATE_KEY_PEM=
# The kid Auth0 generated for that credential. It is not shown in the dashboard;
# read it from the Management API. Auth0 derives it from the JWK thumbprint, so
# the same public key yields the same kid on both applications.
E2E_AUTH0_CREDENTIAL_KID=
# API identifier, for example https://api.example.com
E2E_AUTH0_AUDIENCE=
E2E_AUTH0_USER_SCOPES=openid profile email
# Defaults to the tenant userinfo endpoint when empty
E2E_AUTH0_API_ENDPOINT=
E2E_AUTH0_USERNAME=
E2E_AUTH0_PASSWORD=
